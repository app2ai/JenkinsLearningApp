<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG BUILDS ONLY (src/debug overrides src/main).

    Cleartext HTTP is still blocked globally, with an exception for the hosts a
    local Jenkins on your Windows PC is reached through:
      10.0.2.2   the Android emulator's alias for the host machine's localhost
      127.0.0.1  / localhost  a physical device after `adb reverse tcp:8080 tcp:8080`

    To reach Jenkins on your LAN IP from a physical device instead, add a
    <domain> line for that IP here (debug only), or better, put HTTPS in front of Jenkins.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
